# Environment — never commit API keys
.env

# Virtual environment
.venv/
venv/
env/

# ChromaDB vector store — large binary, rebuild with build_knowledge_base.py
**/chroma_db/

# Raw PDFs — large, source documents not for version control
data/raw_pdfs/

# Allow annotation CSV files needed for Colab training
!data/raw_queries/*.csv

# Python cache
__pycache__/
*.py[cod]
*.pyo

# IDE
.idea/
.vscode/

# Logs
uvicorn.log
*.log

# OS
.DS_Store
Thumbs.db
